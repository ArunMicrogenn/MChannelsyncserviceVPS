# HTTP Webhook Listener
PORT=4000
WEBHOOK_PUBLIC_URL=https://sync.yourhotelpms.com

# PostgreSQL Connection (Object config)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mchannel_pms_sync
PGUSER=mchannel_sync
PGPASSWORD=change_me_strong_password
PGSSL=false

# 64-char hex key (32 bytes) for AES-256-GCM encryption of api_key & webhook_secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCHANNEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker Polling Intervals (milliseconds)
OUTBOX_INTERVAL_MS=5000
PULL_INTERVAL_MS=60000
